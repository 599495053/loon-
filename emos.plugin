#!name = EMOS 签到
#!desc = EMOS 社区自动签到，支持多账号、开关选项、自定义签到文本。
#!author = zjw
#!homepage = https://github.com/599495053/Zhangjiawen
#!icon = https://raw.githubusercontent.com/599495053/tubiaoku/main/icon/emos.png
#!date = 2026-08-31

[Argument]
ACCOUNTS = input, "", tag = 账号列表, desc = 每行一个账号或用英文分号分隔。格式：token 或 token|名称 或 token|名称|签到文本
SIGN_CONTENT = input, "", tag = 全局签到文本, desc = 所有账号的默认签到附加文本
NOTIFY = switch, true, tag = 发送通知, desc = 是否在签到完成后发送通知
SHOW_INFO = switch, true, tag = 显示详细信息, desc = 通知中显示胡萝卜数、连续签到天数等

[Script]
cron "1 0 * * *" script-path=https://raw.githubusercontent.com/599495053/Zhangjiawen/refs/heads/main/emos.loon.js, tag=EMOS 签到, argument=[ACCOUNTS={ACCOUNTS}&SIGN_CONTENT={SIGN_CONTENT}&NOTIFY={NOTIFY}&SHOW_INFO={SHOW_INFO}], timeout=120